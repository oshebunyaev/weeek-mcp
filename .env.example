# Public hostname handled by Caddy.
MCP_DOMAIN=weeek-mcp.example.com

# Remote MCP. Generate with: openssl rand -base64 48
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000
MCP_AUTH_TOKEN=replace-with-a-long-random-token
MCP_MAX_REQUEST_BODY=1048576
# Browser clients only; non-browser MCP clients omit Origin.
# MCP_ALLOWED_ORIGINS=https://trusted-client.example.com

# The production workspace boundary is mandatory in HTTP mode.
WEEEK_ALLOWED_WORKSPACE_ID=replace-with-workspace-id
WEEEK_API_TOKEN=replace-with-weeek-api-token

# Fail closed by default. Enabling writes also requires a non-empty write whitelist.
WEEEK_ALLOW_WRITE=false
WEEEK_READ_PROJECT_IDS=101,102
WEEEK_WRITE_PROJECT_IDS=101
WEEEK_PROPOSAL_TTL=600
WEEEK_PROPOSAL_MAX_PAYLOAD=65536
WEEEK_PROPOSAL_MAX_PENDING=100
WEEEK_PROPOSAL_MAX_TOTAL=1000
WEEEK_PROPOSAL_RETENTION=86400
WEEEK_PROPOSALS_DB=/data/pending/proposals.sqlite3

# Workspace-wide identity/member reads are a separate capability and default off.
WEEEK_ALLOW_WORKSPACE_READS=false

# Knowledge Base session. Seed this persistent path; do not commit the file.
WEEEK_STORAGE_STATE=/data/session/storage_state.json
WEEEK_KB_CACHE_TTL=300

# Optional bootstrap only. Keep automatic re-login off in normal production.
WEEEK_KB_AUTO_LOGIN=false
# WEEEK_EMAIL=
# WEEEK_PASSWORD=

# Build runtime (runtime omits Playwright/Chromium; runtime-kb includes it).
WEEEK_DOCKER_TARGET=runtime-kb

# Optional endpoint overrides for testing only.
# WEEEK_API_BASE=https://api.weeek.net/public/v1
# WEEEK_APP_BASE=https://app.weeek.net
# WEEEK_INTERNAL_API_BASE=https://api.weeek.net
# WEEEK_COLLAB_BASE=wss://collabws.weeek.net
